# Your own alert settings. Created from config/watchlist.example.yaml on first
# run and edited by alert_settings.bat. Not tracked: a tracked file that is
# meant to be edited locally makes every `git pull --rebase` refuse to run,
# which is how the daily report publishing stopped.
config/watchlist.yaml
config/watchlist.yaml.bak
config/watchlist.yaml.tmp
