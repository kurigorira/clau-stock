# Vantage MT5 credentials
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: absolute path to terminal64.exe if multiple MT5 installs are present
MT5_PATH=
# Optional logging level
LOG_LEVEL=INFO

# Gmail SMTP for signal notifications.
# GMAIL_APP_PASSWORD is a 16-char Google App Password (requires 2FA on the account);
# generate at https://myaccount.google.com/apppasswords
# Leave any of these blank to disable email notification (the bot will still trade).
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_TO=
